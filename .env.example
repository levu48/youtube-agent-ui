# Copy to .env and adjust. All paths must be absolute (~ is expanded).

# The separate youtube-agent engine checkout (run `uv sync` there once).
YTA_ENGINE_REPO=~/dev/youtube-agent

# Where engine projects live (must be outside source repositories).
YTA_PROJECTS_ROOT=~/Documents/YouTubeAgent/projects

# UI-owned data: SQLite registry/job history and job logs.
YTA_DATA_DIR=~/Library/Application Support/youtube-agent-ui

# Optional: absolute path to uv (default: PATH, then /opt/homebrew/bin/uv).
# YTA_UV_PATH=/opt/homebrew/bin/uv

# Local Ollama (loopback only) and default model.
YTA_OLLAMA_BASE_URL=http://127.0.0.1:11434
YTA_DEFAULT_MODEL=qwen3:8b

# Offline fixture provider (placeholder text) — for tests/demos only.
YTA_ALLOW_FIXTURE_PROVIDER=false

# Research (M3): allow searches and live page fetches. Each still needs the exact hosts
# confirmed in the browser. false = refuse them (queueing a URL still works).
# YTA_RESEARCH_NETWORK=true
# Search provider: wikipedia, or fixture (offline test pages; needs the fixture flag above).
# YTA_RESEARCH_SEARCH_PROVIDER=wikipedia

# Ports (both bound to 127.0.0.1). If you change the frontend port, also set
# YTA_UI_ORIGINS='["http://127.0.0.1:<port>","http://localhost:<port>"]'.
# YTA_BACKEND_PORT=8000
# YTA_FRONTEND_PORT=3000
